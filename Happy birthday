<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Happy Birthday LIM PHENG AN</title>
  <style>
    body {
      margin: 0;
      padding: 0;
      background: radial-gradient(circle at top, #ffe4e6, #ffc1dc);
      overflow: hidden;
      font-family: 'Comic Sans MS', cursive, sans-serif;
      text-align: center;
      position: relative;
      color: #c2185b;
    }

    .balloons {
      margin-top: 80px;
      display: flex;
      justify-content: center;
      gap: 20px;
      z-index: 2;
      position: relative;
    }

    .balloon {
      position: relative;
      width: 80px;
      height: 100px;
      background: #ff6f91;
      border-radius: 50% 50% 45% 45%;
      box-shadow: inset -4px -8px 12px rgba(0,0,0,0.1),
                  0 3px 8px rgba(0,0,0,0.2);
      animation: float 3s ease-in-out infinite;
    }

    .balloon:before {
      content: "";
      position: absolute;
      bottom: -20px;
      left: 50%;
      transform: translateX(-50%);
      width: 2px;
      height: 40px;
      background: #555;
    }

    .letter {
      position: absolute;
      top: 28%;
      left: 50%;
      transform: translate(-50%, -50%);
      font-size: 28px;
      font-weight: bold;
      color: white;
      text-shadow: 1px 1px 2px black;
    }

    @keyframes float {
      0% { transform: translateY(0); }
      50% { transform: translateY(-20px); }
      100% { transform: translateY(0); }
    }

    .text {
      margin-top: 60px;
      font-size: 40px;
      font-weight: bold;
      text-shadow: 0 0 10px #fff, 0 0 20px #ff4081;
      animation: glow 1.5s ease-in-out infinite alternate;
      z-index: 2;
      position: relative;
    }

    .name {
      font-size: 24px;
      margin-top: 10px;
      color: #880e4f;
      text-shadow: 1px 1px 3px #fff;
      z-index: 2;
      position: relative;
    }

    @keyframes glow {
      from { text-shadow: 0 0 10px #ff4081, 0 0 20px #fff; }
      to   { text-shadow: 0 0 20px #ff4081, 0 0 30px #fff; }
    }

    /* Confetti pieces */
    .confetti {
      position: fixed;
      top: -10px;
      width: 10px;
      height: 10px;
      border-radius: 3px;
      opacity: 0.9;
      animation: fall linear infinite;
      z-index: 1;
      will-change: transform;
    }

    @keyframes fall {
      0% { transform: translateY(-20px) rotate(0deg); opacity: 1; }
      100% { transform: translateY(110vh) rotate(360deg); opacity: 0.7; }
    }
  </style>
</head>
<body>

  <div class="balloons">
    <div class="balloon"><div class="letter">H</div></div>
    <div class="balloon"><div class="letter">B</div></div>
    <div class="balloon"><div class="letter">D</div></div>
    <div class="balloon"><div class="letter">A</div></div>
    <div class="balloon"><div class="letter">N</div></div>
  </div>

  <div class="text">HAPPY BIRTHDAY</div>
  <div class="name">LIM PHENG AN</div>

  <!-- Confetti generator -->
  <script>
    const count = 80;
    for (let i = 0; i < count; i++) {
      const conf = document.createElement('div');
      conf.className = 'confetti';
      const size = 6 + Math.random() * 6;
      conf.style.width = size + 'px';
      conf.style.height = size + 'px';
      conf.style.backgroundColor = `hsl(${Math.random()*360}, 70%, 80%)`;
      conf.style.left = Math.random() * 100 + 'vw';
      const duration = 3000 + Math.random() * 4000;
      const delay = Math.random() * 3000;
      conf.style.animationDuration = `${duration}ms`;
      conf.style.animationDelay = `${delay}ms`;
      document.body.appendChild(conf);
    }
  </script>

</body>
</html>
